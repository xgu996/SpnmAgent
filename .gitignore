# Generated experiment output
outputs/

# Local-only material, never uploaded:
# - all HTML documents (blueprint, lessons, article plan)
# - the article (LaTeX paper, plan, research log); it has its own local git repo inside
# - lesson source code (the lessons' answer key)
*.html
docs/article/
docs/_build/lesson_src/

